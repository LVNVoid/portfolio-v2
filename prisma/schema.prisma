generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String   @db.Text
  location  String?
  email     String
  avatar    String?
  socials   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  content     String?  @db.Text
  tech        String[]
  link        String?
  github      String?
  image       String?
  featured    Boolean  @default(false)
  status      String   @default("LIVE")
  year        Int      @default(2026)
  category    String   @default("Web Application")
  services    Int      @default(1)
  databases   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String   @default("General")
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model Education {
  id          String   @id @default(cuid())
  school      String
  degree      String
  year        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model Certificate {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  issuer        String
  date          DateTime @default(now())
  credentialUrl String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}
